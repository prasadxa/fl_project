# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Raw training data (large Kaggle downloads — regenerate via preprocess.py) ─
data/raw/

# ── CIFAR-10 cache (auto-downloaded by train_gate.py — up to 163 MB) ──────────
data/cifar10_cache/

# ── ScanGate extra training data (local, not committed) ──────────────────────
data/gate_data/

# ── Preprocessed partitions (regenerated by backend/preprocess.py) ───────────
data/partitions/

# ── Temporary API upload buffer ───────────────────────────────────────────────
data/.tmp_uploads/

# ── SQLite runtime files (WAL/SHM are transient, db is regenerated) ───────────
data/*.db
data/*.db-shm
data/*.db-wal

# ── Audit log (runtime, rotating — not source) ────────────────────────────────
data/audit.log

# ── Archived doctor-verified images (patient data — never commit) ─────────────
data/archived_data/

# ── Pending doctor-verified images (patient data — never commit) ──────────────
data/new_collected_data/glioma/*.jpg
data/new_collected_data/glioma/*.jpeg
data/new_collected_data/glioma/*.png
data/new_collected_data/meningioma/*.jpg
data/new_collected_data/meningioma/*.jpeg
data/new_collected_data/meningioma/*.png
data/new_collected_data/notumor/*.jpg
data/new_collected_data/notumor/*.jpeg
data/new_collected_data/notumor/*.png
data/new_collected_data/pituitary/*.jpg
data/new_collected_data/pituitary/*.jpeg
data/new_collected_data/pituitary/*.png
data/new_collected_data/normal/*.jpg
data/new_collected_data/normal/*.jpeg
data/new_collected_data/normal/*.png
data/new_collected_data/pneumonia/*.jpg
data/new_collected_data/pneumonia/*.jpeg
data/new_collected_data/pneumonia/*.png

# ── Model weights ─────────────────────────────────────────────────────────────
# Keep: global_model.pth (production), global_model_round_N.pth (clean rounds)
# Ignore: timestamped checkpoint dumps  e.g. global_model_round_5_20260228_064427.pth
models/global_model_round_*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.pth

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/*.log
logs/*_err.log

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml
